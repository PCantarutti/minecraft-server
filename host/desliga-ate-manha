#!/bin/sh
# Desligamento agendado do host, com acordar pelo relogio da placa-mae.
#
# Instalado em /usr/local/bin/desliga-ate-manha. O painel (aba Energia) edita
# SO as linhas DIA_1..7= abaixo, com sed, e gera a partir delas o OnCalendar
# do timer -- veja energia_definir_agenda() em panel/app.py. Esta copia e
# versionada para que reinstalar a maquina nao perca o script; a agenda viva
# e a do host.
#
# Agenda semanal, numerada como `date +%u` (1=seg ... 7=dom):
#   DIA_n=ACORDA-DORME  horarios do dia. DORME <= ACORDA = madrugada do dia
#                       seguinte (08:00-00:00 dorme na virada do dia).
#   ~ na frente         desliga aquela metade sem perder o horario:
#                       08:00-~00:00 acorda sozinha mas NAO dorme sozinha.
# Este script so le o ACORDA; o DORME vira OnCalendar no timer (15 min antes,
# por causa do aviso -- veja AVISO_MIN).
DIA_1=08:00-00:00
DIA_2=08:00-00:00
DIA_3=08:00-00:00
DIA_4=08:00-00:00
DIA_5=08:00-00:00
DIA_6=08:00-00:00
DIA_7=08:00-00:00
IFACE=enp2s0

# Aviso no chat antes de desligar. O timer dispara AVISO_MIN antes do horario
# de dormir; aqui o script avisa e espera. Qualquer jogador digitando !ficar
# cancela; o painel cancela parando o service ("Pular esta noite"). O
# "desligar agora" do painel roda com AVISO_MIN=0.
AVISO_MIN=${AVISO_MIN:-15}
diga() { docker exec minecraft rcon-cli say "$*" >/dev/null 2>&1 || true; }
if [ "$AVISO_MIN" -gt 0 ]; then
  INICIO=$(date +%s)
  FIM=$((INICIO + AVISO_MIN * 60))
  diga "A maquina desliga sozinha em $AVISO_MIN min (Minecraft junto). Digite !ficar no chat para cancelar."
  LEMBROU=$AVISO_MIN
  while [ "$(date +%s)" -lt "$FIM" ]; do
    # --since com o instante do aviso: um !ficar de outra noite nao vale.
    if docker logs --since "$INICIO" minecraft 2>&1 | grep -q '> !ficar'; then
      diga "Desligamento cancelado. A maquina fica ligada ate o proximo horario de dormir."
      echo "desliga-ate-manha: cancelado pelo chat (!ficar)"
      exit 0
    fi
    FALTA=$(( (FIM - $(date +%s) + 59) / 60 ))
    for M in 5 1; do
      if [ "$FALTA" -le "$M" ] && [ "$LEMBROU" -gt "$M" ]; then
        diga "A maquina desliga em $M min. Digite !ficar para cancelar."
        LEMBROU=$M
      fi
    done
    sleep 10
  done
  diga "Desligando agora. Mundo sendo salvo."
fi

# Para o Minecraft com calma ANTES do rtcwake. No shutdown do systemd quem
# para o container e o dockerd, que da SIGTERM e mata a forca em ~10s --
# medido aqui, salvar so o overworld leva 5,34s, e region file escrito pela
# metade e mapa corrompido. 120s sao de folga.
#
# Isto conta como parada manual: so volta no boot porque a politica do
# container e `always` (MC_RESTART no .env). Com `unless-stopped` o servidor
# ficaria parado depois de cada noite.
docker stop -t 120 minecraft 2>/dev/null || true

# Proximo horario de acordar depois de agora: hoje se o dia esta ligado e a
# hora ainda nao passou, senao o proximo dia ligado. N vai ate 7 para cobrir
# "so um dia ligado e a hora dele ja passou hoje" (mesmo dia, semana que vem).
#
# NAO use `date -d "tomorrow $ACORDA"`: o timer dispara a 00:00, quando o
# "hoje" ja e o dia novo, e "tomorrow" marcava o dia seguinte -- 39 horas
# desligada em vez de 15. E tambem nao use "+1 day" junto de uma data
# absoluta: o GNU date devolveu 14:00 no lugar de 15:00 no teste. Pegar a
# data do dia e so depois fixar a hora nao tem essa ambiguidade.
# ponytail: N*86400 assume dia de 24 h; SP nao tem horario de verao desde 2019.
#
# RTCWAKE_AGORA existe para o teste injetar um "agora" fixo.
AGORA=${RTCWAKE_AGORA:-$(date +%s)}
ALVO=
for N in 0 1 2 3 4 5 6 7; do
  T=$((AGORA + N * 86400))
  DIA=$(TZ=America/Sao_Paulo date -d "@$T" +%Y-%m-%d)
  DOW=$(TZ=America/Sao_Paulo date -d "@$T" +%u)
  eval "FAIXA=\${DIA_$DOW}"
  ACORDA=${FAIXA%-*}
  case "$ACORDA" in ""|"~"*) continue ;; esac
  A=$(TZ=America/Sao_Paulo date -d "$DIA $ACORDA" +%s)
  if [ "$A" -gt "$AGORA" ]; then ALVO=$A; break; fi
done

# Rearma o Wake-on-LAN segundos antes de desligar.
#
# wake-on-lan.service ja faz isso no boot, mas o r8169 pode perder o ajuste
# quando a interface cai na sequencia de shutdown -- e aí o magic packet chega
# numa placa que nao esta ouvindo. Rearmar aqui e o ultimo momento possivel.
#
# O echo nao e enfeite: deixa no journal como a placa ficou armada no instante
# do poweroff. Sem esse registro, "o WoL nao funcionou" continua sendo palpite
# entre BIOS, driver e pacote.
ethtool -s "$IFACE" wol g 2>/dev/null || true
echo "desliga-ate-manha: $(ethtool "$IFACE" 2>/dev/null | grep -i 'Wake-on:' | tr -d '	')"
echo "desliga-ate-manha: wakeup=$(cat /sys/class/net/$IFACE/device/power/wakeup 2>/dev/null)"

if [ -n "$ALVO" ]; then
  rtcwake -m off -t "$ALVO"
else
  # Nenhum dia acorda sozinho. Desliga sem despertador -- volta pelo botao
  # ou pelo WoL.
  echo "desliga-ate-manha: nenhum dia acorda sozinho, desligando sem despertador"
  systemctl poweroff
fi
