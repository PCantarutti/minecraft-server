# Copie p/ .env no servidor.  cp .env.example .env
#
# Servidor: i7-4790 (4C/8T), 16 GB, dividindo a máquina com a stack igenda.
# Dois jogadores.
#
# Os valores de memória abaixo são PONTO DE PARTIDA. Meça antes de subir —
# Fase 1 do SETUP.md diz como e tem a tabela de heap por folga real.

# Versão do Minecraft. LATEST segue a última; pine (ex.: 26.1) se usar plugin
# ou se o cliente reclamar de versão.
MC_VERSION=LATEST

# Tag de Java da imagem. PRECISA acompanhar MC_VERSION — Minecraft 26.1+ exige
# Java 25 e nem sobe em Java 21. Se o container entrar em loop com
# "requires running the server with Java NN or above", é só trocar aqui.
MC_JAVA=java25

# Heap da JVM e teto do container. SEMPRE limite = heap + 1G.
#
#   `free -h` → coluna `available`     MC_HEAP    MC_MEM_LIMIT
#   >= 8 GB .........................  3G         4G
#   6-8 GB ..........................  2G         3G
#   4-6 GB ..........................  1500M      2G
#   < 4 GB ..........................  pare e meça de novo
#
# Não encha os 16 GB: o que sobra vira page cache do Postgres, e é isso que
# mantém a api do igenda rápida. Heap grande com 2 players não melhora nada.
MC_HEAP=3G
MC_MEM_LIMIT=4G

# Teto de CPU. 4C/8T: 2.5 deixa ~1,5 core garantido pra postgres+api.
# cpu_shares: 256 no compose já faz a stack igenda ganhar em disputa.
MC_CPUS=2.5

MC_MAX_PLAYERS=4

# Distância de renderização, em chunks (16 blocos cada).
#
# VIEW      = o que o servidor manda pro cliente desenhar. Custa RAM e rede.
# SIMULATION= o que de fato ticka (mobs, redstone, plantação). Custa CPU.
#
# SIMULATION nunca precisa passar de VIEW, e é o que derruba o tick primeiro.
# Com 2 players nesta máquina (16 GB, 4C/8T) dá pra ser generoso no VIEW:
#
#   padrão vanilla ...... 10 / 8
#   confortável aqui .... 16 / 10
#   atual ............... 24 / 12   <- rodando bem aqui (medido 2026-11-05)
#
# 24/12 validado nesta máquina com 2 players. Se um dia pesar:
# `docker exec -i minecraft rcon-cli tps` — abaixo de 19, baixe o SIMULATION
# primeiro (12 -> 10), que é o que custa CPU. O VIEW em 24 custa RAM e rede,
# não tick.
#
# O cliente também tem o próprio render distance: vale o MENOR dos dois.
# Aumentar aqui sem aumentar no cliente não muda nada na tela — no cliente,
# 24 chunks também pede uma placa de vídeo que dê conta.
MC_VIEW_DISTANCE=24
MC_SIMULATION_DISTANCE=12

# Seus nicks do Minecraft (viram admin no primeiro boot). Maiúsculas exatas.
MC_OPS=

# Onde a porta 25565 escuta no host: o IP da tailnet deste servidor
# (`tailscale ip -4`). Só quem está na tailnet alcança — UFW segue só com
# OpenSSH, nenhuma porta aberta pro mundo.
#
# Tailscale só funciona aqui por causa da exclusão de `tailscale.com` no split
# tunnel do WARP. Se o `tailscale up` pendurar, veja a Fase 2 do SETUP.md.
#
#   127.0.0.1  -> só no loopback; é o valor do caminho playit.gg (Fase 3-B)
#   0.0.0.0    -> abriria a porta pro mundo: exigiria `ufw allow 25565/tcp` e
#                 exporia o IP residencial. Não faça.
MC_BIND=100.x.y.z

# Política de restart do container. Escrita pelos botões "Subir no boot" /
# "Não subir no boot" da aba Automação — mexa pelo painel, não aqui.
#
#   always         sobe junto com a máquina, mesmo que você tenha desligado o
#                  Minecraft antes. É o que a máquina acordando às 15:00 por
#                  rtcwake precisa para o servidor estar no ar sem você entrar
#                  no painel.
#   unless-stopped sobe no boot SÓ se estava rodando quando a máquina desligou.
#                  Desligou na mão à tarde? Não volta no boot da noite.
#   no             nunca sobe sozinho.
MC_RESTART=unless-stopped

# ---- Painel de controle ------------------------------------------------------
# Mesma regra da porta do jogo: só a tailnet. O painel tem o socket do Docker
# montado — exposto na internet seria root nesta máquina inteira.
PANEL_BIND=100.x.y.z
PANEL_PORT=8080
PANEL_MEM_LIMIT=512M
PANEL_CPUS=1.0

# Onde os backups caem no host. Dentro do diretório do projeto por padrão;
# aponte para fora (ex.: /home/pedro/backups) se quiser rsync separado.
BACKUP_DIR=./backups

# ---- Opções do servidor editáveis pelo painel --------------------------------
# A aba Configuração escreve estas chaves aqui e roda `compose up -d mc`.
MC_LEVEL=world
MC_DIFFICULTY=normal
MC_GAMEMODE=survival
MC_MOTD=Servidor do Pedro
MC_PVP=true
MC_ONLINE_MODE=true
MC_SPAWN_PROTECTION=0

# ---- Geração do mundo --------------------------------------------------------
# Escritas pelo botão "Criar mundo" do painel. Só valem na CRIAÇÃO: num mundo
# que já existe, semente e tipo vivem no level.dat e o servidor ignora isto.
MC_SEED=
MC_LEVEL_TYPE=minecraft:normal
MC_GENERATE_STRUCTURES=true
MC_MAX_WORLD_SIZE=29999984

# ---- Regras do jogo ----------------------------------------------------------
MC_HARDCORE=false
MC_FORCE_GAMEMODE=false
MC_ALLOW_NETHER=true
MC_ALLOW_FLIGHT=false
MC_SPAWN_MONSTERS=true
MC_SPAWN_ANIMALS=true
MC_SPAWN_NPCS=true
MC_COMMAND_BLOCK=false
